{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
        "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
    },
    "permissions": {
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.*)",
            "Read(**/*.pem)",
            "Read(**/*.key)",
            "Bash(git push)",
            "Bash(git push *)",
            "PowerShell(git push)",
            "PowerShell(git push *)",
            "Bash(gh pr create *)",
            "Bash(gh pr merge *)",
            "PowerShell(gh pr create *)",
            "PowerShell(gh pr merge *)"
        ],
        "ask": [
            "Bash(git merge *)",
            "Bash(git rebase *)",
            "Bash(git reset --hard *)",
            "Bash(git branch -D *)",
            "Bash(git remote *)",
            "PowerShell(git merge *)",
            "PowerShell(git rebase *)",
            "PowerShell(git reset --hard *)",
            "PowerShell(git branch -D *)",
            "PowerShell(git remote *)"
        ]
    },
    "hooks": {
        "TaskCreated": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv",
                        "args": ["run", "--no-project", "--offline", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/task_gate.py"],
                        "timeout": 30
                    }
                ]
            }
        ],
        "TaskCompleted": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv",
                        "args": ["run", "--no-project", "--offline", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/task_gate.py"],
                        "timeout": 300
                    }
                ]
            }
        ]
    }
}
